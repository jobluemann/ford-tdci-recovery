# Ford TDCi Recovery — AI assistant configuration (copy to .env or export)
# Nothing here is required: the offline known-issues lookup works with no AI.

# === RECOMMENDED FREE SETUP: one Groq key, two models ===
# Get a free key at https://console.groq.com (no credit card)
# Research stage = fast GPT-OSS 20B; Diagnostics stage = Qwen
# (llama-3.1-8b-instant was shut down by Groq on 2026-08-16)
FTR_AI_PROVIDER=groq
GROQ_API_KEY=gsk-your-key-here
FTR_RESEARCH_PROVIDER=groq
FTR_RESEARCH_MODEL=openai/gpt-oss-20b
FTR_DIAG_PROVIDER=groq
FTR_DIAG_MODEL=qwen/qwen3.6-27b

# === ALTERNATIVE: one OpenRouter key, free models (:free suffix) ===
# https://openrouter.ai — filter model list by "Free"
# FTR_AI_PROVIDER=openrouter
# AI_API_KEY=sk-or-your-key-here
# FTR_RESEARCH_PROVIDER=openrouter
# FTR_RESEARCH_MODEL=meta-llama/llama-3.1-8b-instruct:free
# FTR_DIAG_PROVIDER=openrouter
# FTR_DIAG_MODEL=qwen/qwen-2.5-7b-instruct:free

# === OTHER PRESETS (single-model, one provider var) ===
# FTR_AI_PROVIDER=gemini    AI_API_KEY=<Google AI Studio key>   (free tier)
# FTR_AI_PROVIDER=grok      AI_API_KEY=<xAI key>                (paid)
# FTR_AI_PROVIDER=ollama    (no key — runs locally, default)

# === FULLY CUSTOM ===
# FTR_AI_PROVIDER=custom
# AI_BASE_URL=https://your-endpoint/v1
# AI_MODEL=your-model
# AI_API_KEY=your-key
